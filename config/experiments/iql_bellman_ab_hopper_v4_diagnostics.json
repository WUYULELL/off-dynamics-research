{
  "experiment_name": "hopper_bellman_ab_v4_diagnostics",
  "label": "IQL_BELLMAN_AB-v4-diagnostics",
  "conda_env": "offdynamics",
  "policy": "IQL_BELLMAN_AB",
  "environment": "hopper-kinematic-legjnt",
  "shift_level": "medium",
  "source_type": "medium",
  "target_type": "medium",
  "mode": 3,
  "target_fraction": 0.1,
  "paper_style_source_target": true,
  "seeds": [3],
  "max_step": 500000,
  "out_dir": "r_ab_hopper_v4_diag",
  "parameters": {
    "bellman_alpha": 1.0,
    "budget_mode": "adaptive",
    "budget_min": 0.1,
    "budget_max": 0.33,
    "budget_ratio_center": 5.0,
    "budget_temp": 0.3,
    "budget_ema_decay": 0.95,
    "use_budget_ema": true,
    "adaptive_budget_update_interval": 10,
    "fixed_source_budget": 0.2,
    "min_weight": 0.05,
    "max_weight": 1.0,
    "source_loss_weight": 1.0,
    "knn_k": 5,
    "target_bank_size": 20000,
    "knn_chunk_size": 5000,
    "normalize_bellman_mismatch": true,
    "exclude_self_in_target_knn": true,
    "diagnostic_log_interval": 5000
  }
}
